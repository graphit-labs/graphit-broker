# Broker-owned upstream credentials. Never commit real values.
OPENAI_API_KEY=
COHERE_API_KEY=

# Optional API-key principal. Store a SHA-256 hex digest, not the original key.
BROKER_LOCAL_TOKEN_SHA256=

# Used by services.s3.mode=assume_role through the standard AWS credential chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
