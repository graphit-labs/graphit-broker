# Durable broker database. SQLite is the single-node default. PostgreSQL/MySQL DSN examples:
# postgres://graphit:password@postgres:5432/graphit?sslmode=require
# graphit:password@tcp(mysql:3306)/graphit?parseTime=true
BROKER_DATABASE_DRIVER=sqlite
BROKER_DATABASE_DSN=/var/lib/graphit-broker/broker.db

# Broker-owned upstream credentials. Never commit real values.
OPENAI_API_KEY=
COHERE_API_KEY=

# Authentication pepper: at least 32 random bytes, kept outside SQL. It protects local passwords,
# browser sessions, and OIDC state with separate domains. Local password hashes live only in SQL.
BROKER_AUTH_TOKEN_PEPPER=

# Optional adaptive local-login CAPTCHA. Create keys for either Cloudflare Turnstile or Google
# reCAPTCHA v2 Checkbox, select that provider in config.yaml, and keep the secret out of Git.
BROKER_LOCAL_CAPTCHA_SITE_KEY=
BROKER_LOCAL_CAPTCHA_SECRET_KEY=

# Unified OIDC client used for broker identities and the browser authorization-code flow.
BROKER_OIDC_CLIENT_ID=graphit-broker
BROKER_OIDC_CLIENT_SECRET=
BROKER_OIDC_REDIRECT_URL=https://broker.example.com/admin/auth/callback

# Direct route credentials used only inside the broker to create short-lived signed URLs.
PRIMARY_S3_ACCESS_KEY_ID=
PRIMARY_S3_SECRET_ACCESS_KEY=
PUBLIC_S3_ACCESS_KEY_ID=
PUBLIC_S3_SECRET_ACCESS_KEY=
