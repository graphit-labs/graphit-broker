# Durable broker database. SQLite is the single-node default. PostgreSQL/MySQL DSN examples:
# postgres://graphit:password@postgres:5432/graphit?sslmode=require
# graphit:password@tcp(mysql:3306)/graphit?parseTime=true
BROKER_DATABASE_DRIVER=sqlite
BROKER_DATABASE_DSN=/var/lib/graphit-broker/broker.db

# Broker-owned upstream credentials. Never commit real values.
OPENAI_API_KEY=
COHERE_API_KEY=

# Optional API-key principal. Store a SHA-256 hex digest, not the original key.
BROKER_LOCAL_TOKEN_SHA256=

# Administration OIDC. The subject is the exact immutable `sub` claim of the bootstrap owner.
BROKER_SUPERADMIN_SUBJECT=
BROKER_ADMIN_OIDC_ISSUER=https://identity.example.com
BROKER_ADMIN_OIDC_CLIENT_ID=graphit-broker-admin
BROKER_ADMIN_OIDC_CLIENT_SECRET=
BROKER_ADMIN_OIDC_REDIRECT_URL=https://broker.example.com/admin/auth/callback

# Direct route credentials used only inside the broker to create short-lived signed URLs.
PRIMARY_S3_ACCESS_KEY_ID=
PRIMARY_S3_SECRET_ACCESS_KEY=
PUBLIC_S3_ACCESS_KEY_ID=
PUBLIC_S3_SECRET_ACCESS_KEY=
